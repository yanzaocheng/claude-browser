{
  "name": "claude-browser",
  "version": "0.1.0",
  "description": "Claude Browser：类 AdsPower 的指纹浏览器，支持多环境隔离、指纹伪装、代理链和兼容 AdsPower 的本地 API",
  "type": "module",
  "main": "src/main.js",
  "bin": {
    "claude-browser": "src/main.js"
  },
  "scripts": {
    "start": "node src/main.js",
    "serve": "node src/main.js --no-open",
    "package": "node scripts/package.mjs --zip",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
